<header class="q-header">
  <div class="q-header__title-wrap">
    <span class="q-header__rule"></span>
    <div>
      <div class="q-header__eyebrow">INFORME TRIMESTRAL · TRACKING PODEROSA</div>
      <h1 class="q-header__title"><%= title %></h1>
      <% if (subtitle) { %>
        <div class="q-header__subtitle"><%= subtitle %></div>
      <% } %>
    </div>
  </div>

  <div class="q-period-chip">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="5" width="18" height="16" rx="2"></rect>
      <path d="M16 3v4M8 3v4M3 10h18"></path>
      <path d="M7 13h3M12 13h3M17 13h.01M7 17h3M12 17h3M17 17h.01"></path>
    </svg>
    <span><%= String(periodLabel || '').toUpperCase() %></span>
  </div>
</header>
