<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= slideTitle %></title>
  <link rel="stylesheet" href="/public/styles.css">
  <link rel="stylesheet" href="/public/quarterly.css">
</head>
<body class="slide-body slide<%= slideNumber %>-body">
  <div class="canvas">
    <% if (standalone) { %>
      <main class="quarterly-slide quarterly-slide--standalone slide<%= slideNumber %>-root">
        <%- include('partials/' + viewName) %>
      </main>
    <% } else { %>
      <main class="quarterly-slide q-page slide<%= slideNumber %>-root">
        <%- include('components/quarterly-header', {
          title: slideTitle,
          subtitle: slideSubtitle,
          periodLabel: metrics.periodLabel || period
        }) %>

        <section class="q-content <%= viewClass %>">
          <%- include('partials/' + viewName) %>
        </section>

        <%- include('components/quarterly-footer', {
          sourceLabel: metrics.sourceLabel,
          footerCenter: metrics.footerCenter
        }) %>
      </main>
    <% } %>
  </div>
</body>
</html>
