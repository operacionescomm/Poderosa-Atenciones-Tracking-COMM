<!doctype html>

<html lang="es">

<head>

  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>
    <%= slideTitle %>
  </title>


  <link
    rel="stylesheet"
    href="/public/styles.css"
  >

  <link
    rel="stylesheet"
    href="/public/quarterly.css"
  >

</head>


<body class="slide-body slide<%= slideNumber %>-body">


  <div class="canvas">


    <main class="quarterly-slide q-page slide<%= slideNumber %>-root">


      <!-- HEADER COMÚN PARA LOS 9 SLIDES -->

      <%- include('components/quarterly-header', {

        eyebrow:
          slideEyebrow,

        title:
          slideTitle,

        subtitle:
          slideSubtitle,

        periodLabel:
          metrics.periodLabel || period

      }) %>



      <!-- CONTENIDO PROPIO DE CADA SLIDE -->

      <section class="q-content <%= viewClass %>">

        <%- include('partials/' + viewName) %>

      </section>



      <!-- FOOTER COMÚN -->

      <%- include('components/quarterly-footer', {

        sourceLabel:
          metrics.sourceLabel,

        footerCenter:
          metrics.footerCenter

      }) %>


    </main>


  </div>


</body>

</html>
