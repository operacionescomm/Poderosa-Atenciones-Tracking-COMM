<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= slideTitle %></title>
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
  <div class="canvas">
    <section class="slide-frame">
      <header class="report-header">
        <div class="header-title">
          <span class="title-rule"></span>
          <div>
            <div class="eyebrow">INFORME MENSUAL · TRACKING PODEROSA</div>
            <h1><%= slideTitle %></h1>
            <% if (viewClass === 'summary') { %>
              <div class="header-subtitle">VISIBILIDAD HOY. OPERACIONES MÁS EFICIENTES MAÑANA.</div>
            <% } %>
          </div>
        </div>
        <div class="header-meta">
          <span class="period-chip">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>
              <path d="M8 13h3v3H8zM13 13h3v3h-3z"/>
            </svg>
            <%= period.toUpperCase() %>
          </span>
        </div>
      </header>

      <main class="slide-content <%= viewClass %>">
        <%- include('partials/' + viewName) %>
      </main>

      <footer class="report-footer">
        <span>COMM · Digitalizamos la minería peruana</span>
        <span><%= operation %> · <%= reportName %></span>
        <span><%= slideNumber %></span>
      </footer>
    </section>
  </div>
</body>
</html>
