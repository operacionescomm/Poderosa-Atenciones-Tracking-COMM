<%

/* =========================================================
   DATA
   ========================================================= */

const q =
  typeof quarterly !== 'undefined' &&
  quarterly
    ? quarterly
    : {};


/*
   Preferimos allSupplies porque necesitamos conocer
   también los insumos que estén fuera del Top 10.

   Después del pequeño ajuste de server.js que te dejo
   debajo de este código, allSupplies estará disponible.
*/

const supplyInput =
  typeof allSupplies !== 'undefined' &&
  Array.isArray(allSupplies) &&
  allSupplies.length

    ? allSupplies

    : (
        Array.isArray(q.supplies) &&
        q.supplies.length

          ? q.supplies

          : (
              typeof supplies !== 'undefined' &&
              Array.isArray(supplies)

                ? supplies

                : []
            )
      );


/* =========================================================
   HELPERS
   ========================================================= */

function tri18Number(value) {

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : 0;

}


function tri18Text(value) {

  return String(
    value ?? ''
  ).trim();

}


function tri18Quantity(value) {

  const n =
    tri18Number(value);


  if (
    typeof formatNumber ===
    'function'
  ) {

    return formatNumber(
      n,
      Number.isInteger(n)
        ? 0
        : 1
    );

  }


  return n.toLocaleString(
    'es-PE',
    {
      maximumFractionDigits: 1
    }
  );

}


function tri18Pct(value) {

  const n =
    tri18Number(value);


  return (
    n.toLocaleString(
      'es-PE',
      {
        minimumFractionDigits: 1,
        maximumFractionDigits: 1
      }
    ) +
    '%'
  );

}


function tri18Short(
  value,
  max = 38
) {

  const input =
    tri18Text(value);


  if (
    input.length <= max
  ) {

    return input;

  }


  return (
    input
      .slice(
        0,
        max - 1
      )
      .trim() +
    '…'
  );

}


/* =========================================================
   NORMALIZAR INSUMOS
   ========================================================= */

const normalizedSupplies =
  supplyInput
    .map(
      item => ({

        name:
          tri18Text(
            item.name ??
            item.nombre ??
            item.insumo
          ),

        quantity:
          tri18Number(
            item.quantity ??
            item.cantidad
          ),

        unit:
          tri18Text(
            item.unit ??
            item.unidad ??
            ''
          )

      })
    )
    .filter(
      item =>
        item.name &&
        item.quantity >= 0
    )
    .sort(
      (
        a,
        b
      ) =>
        b.quantity -
        a.quantity
    );


/* =========================================================
   TOP 10
   ========================================================= */

const top10 =
  normalizedSupplies
    .slice(
      0,
      10
    );


const topAnalyzed =
  top10.length;


const totalSupplyTypes =
  normalizedSupplies.length;


/* =========================================================
   CANTIDAD ACUMULADA
   ========================================================= */

const totalQuantity =
  normalizedSupplies
    .reduce(
      (
        total,
        item
      ) =>
        total +
        item.quantity,

      0
    );


const top10Quantity =
  top10
    .reduce(
      (
        total,
        item
      ) =>
        total +
        item.quantity,

      0
    );


/* =========================================================
   PRINCIPALES INSUMOS
   ========================================================= */

const principal =
  top10[0] || {
    name: 'Sin datos',
    quantity: 0,
    unit: ''
  };


const second =
  top10[1] || {
    name: 'Sin datos',
    quantity: 0,
    unit: ''
  };


const third =
  top10[2] || {
    name: 'Sin datos',
    quantity: 0,
    unit: ''
  };


/* =========================================================
   PARTICIPACIONES
   ========================================================= */

function tri18Share(quantity) {

  return (
    totalQuantity > 0

      ? (
          tri18Number(quantity) /
          totalQuantity
        ) * 100

      : 0
  );

}


const principalShare =
  tri18Share(
    principal.quantity
  );


const secondShare =
  tri18Share(
    second.quantity
  );


const thirdShare =
  tri18Share(
    third.quantity
  );


const top3Quantity =
  top10
    .slice(
      0,
      3
    )
    .reduce(
      (
        total,
        item
      ) =>
        total +
        item.quantity,

      0
    );


const top3CumulativeShare =
  totalQuantity > 0

    ? (
        top3Quantity /
        totalQuantity
      ) * 100

    : 0;


const top10Share =
  totalQuantity > 0

    ? (
        top10Quantity /
        totalQuantity
      ) * 100

    : 0;


/* =========================================================
   AGREGAR % A CADA FILA
   ========================================================= */

top10.forEach(
  item => {

    item.share =
      tri18Share(
        item.quantity
      );

  }
);


/* =========================================================
   COMPLETAR TABLA A 10 FILAS
   ========================================================= */

const tableRows =
  Array.from(
    {
      length: 10
    },
    (
      _,
      index
    ) =>
      top10[index] ||
      null
  );


/* =========================================================
   ESCALA DEL GRÁFICO
   ========================================================= */

function tri18NiceStep(value) {

  if (
    !Number.isFinite(value) ||
    value <= 0
  ) {

    return 50;

  }


  const exponent =
    Math.floor(
      Math.log10(value)
    );


  const magnitude =
    Math.pow(
      10,
      exponent
    );


  const normalized =
    value /
    magnitude;


  const choices = [
    1,
    2,
    2.5,
    5,
    10
  ];


  for (
    const choice
    of choices
  ) {

    if (
      choice >= normalized
    ) {

      return (
        choice *
        magnitude
      );

    }

  }


  return (
    10 *
    magnitude
  );

}


const maximumQuantity =
  Math.max(
    1,
    ...top10.map(
      item =>
        item.quantity
    )
  );


const rawStep =
  maximumQuantity /
  7;


const axisStep =
  tri18NiceStep(
    rawStep
  );


/*
   Dejamos un intervalo adicional
   para que la barra principal no toque
   el borde superior.

   295 → 350
*/

let axisMaximum =
  (
    Math.ceil(
      maximumQuantity /
      axisStep
    ) +
    1
  ) *
  axisStep;


if (
  axisMaximum <= 0
) {

  axisMaximum = 350;

}


const axisTicks = [];


for (
  let tick = 0;
  tick <= axisMaximum + 0.0001;
  tick += axisStep
) {

  axisTicks.push(
    Number(
      tick.toFixed(6)
    )
  );

}


/* =========================================================
   GEOMETRÍA DEL GRÁFICO
   ========================================================= */

const chart = {

  left: 70,

  right: 822,

  top: 16,

  bottom: 248

};


const chartWidth =
  chart.right -
  chart.left;


const chartHeight =
  chart.bottom -
  chart.top;


const chartCount =
  Math.max(
    1,
    top10.length
  );


const slotWidth =
  chartWidth /
  chartCount;


const barWidth =
  Math.min(
    48,
    slotWidth * .64
  );


const chartBars =
  top10.map(
    (
      item,
      index
    ) => {

      const height =
        (
          item.quantity /
          axisMaximum
        ) *
        chartHeight;


      const centerX =
        chart.left +
        slotWidth *
        index +
        slotWidth / 2;


      return {

        ...item,

        x:
          centerX -
          barWidth / 2,

        centerX,

        y:
          chart.bottom -
          height,

        width:
          barWidth,

        height

      };

    }
  );


const chartUnit =
  tri18Text(
    q.supplyChartUnit ??
    q.unidadGraficoInsumos ??
    'und'
  );

%>


