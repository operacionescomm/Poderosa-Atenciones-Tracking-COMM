          <circle
            cx="24"
            cy="24"
            r="17"
            fill="#ffffff"
          ></circle>

          <path
            d="
              M24 7
              A17 17 0 0 1
              41 24
              H24
              Z
            "
            fill="#0da7b5"
          ></path>

        </svg>

      </div>


      <div class="tri18-kpi-copy">

        <div class="tri18-kpi-label">
          TOP 2<br>
          PARTICIPACIÓN
        </div>

        <div class="tri18-kpi-number">
          <%= tri18Pct(secondShare) %>
        </div>

      </div>

    </article>



    <!-- TOP 3 -->

    <article class="tri18-kpi blue">

      <div class="tri18-kpi-icon">

        <svg viewBox="0 0 48 48">

          <rect
            x="8"
            y="29"
            width="7"
            height="12"
            rx="1.5"
            fill="#ffffff"
          ></rect>

          <rect
            x="20"
            y="20"
            width="7"
            height="21"
            rx="1.5"
            fill="#ffffff"
          ></rect>

          <rect
            x="32"
            y="10"
            width="7"
            height="31"
            rx="1.5"
            fill="#ffffff"
          ></rect>

        </svg>

      </div>


      <div class="tri18-kpi-copy">

        <div class="tri18-kpi-label">
          TOP 3<br>
          PARTICIPACIÓN
        </div>

        <div class="tri18-kpi-number">
          <%= tri18Pct(thirdShare) %>
        </div>

      </div>

    </article>


  </section>



  <!-- =====================================================
       PARTE CENTRAL
       ===================================================== -->

  <section class="tri18-middle">


    <!-- ===================================================
         GRÁFICO
         =================================================== -->

    <article class="tri18-card">


      <div class="tri18-card-header">

        <div class="tri18-card-header-icon">

          <svg viewBox="0 0 48 48">

            <rect
              x="7"
              y="29"
              width="8"
              height="11"
              rx="1.5"
              fill="#ffffff"
            ></rect>

            <rect
              x="20"
              y="20"
              width="8"
              height="20"
              rx="1.5"
              fill="#ffffff"
            ></rect>

            <rect
              x="33"
              y="8"
              width="8"
              height="32"
              rx="1.5"
              fill="#ffffff"
            ></rect>

          </svg>

        </div>

        <div class="tri18-card-title">
          Top 10 por cantidad utilizada
        </div>

      </div>


      <div class="tri18-chart-legend">

        <span class="tri18-chart-legend-box"></span>

        <span>
          Cantidad (<%= chartUnit %>)
        </span>

      </div>


      <svg
        class="tri18-chart-svg"
        viewBox="0 0 840 338"
        aria-hidden="true"
      >


        <defs>

          <linearGradient
            id="tri18Bars"
            x1="0"
            y1="0"
            x2="0"
            y2="1"
          >

            <stop
              offset="0%"
              stop-color="#16b6c0"
            ></stop>

            <stop
              offset="100%"
              stop-color="#0797aa"
            ></stop>

          </linearGradient>

        </defs>


        <!-- GRID -->

        <% axisTicks.forEach(function(tick) {

          const y =
            chart.bottom -
            (
              tick /
              axisMaximum
            ) *
            chartHeight;

        %>

          <line
            class="tri18-grid-line"

            x1="<%= chart.left %>"
            y1="<%= y %>"

            x2="<%= chart.right %>"
            y2="<%= y %>"
          ></line>


          <text
            class="tri18-axis-label"

            x="<%= chart.left - 12 %>"
            y="<%= y + 5 %>"

            text-anchor="end"
          >
            <%= tri18Quantity(tick) %>
          </text>

        <% }); %>


        <!-- EJES -->

        <line
          class="tri18-axis-line"

          x1="<%= chart.left %>"
          y1="<%= chart.top %>"

          x2="<%= chart.left %>"
          y2="<%= chart.bottom %>"
        ></line>


        <line
          class="tri18-axis-line"

          x1="<%= chart.left %>"
          y1="<%= chart.bottom %>"

          x2="<%= chart.right %>"
          y2="<%= chart.bottom %>"
        ></line>


        <!-- TÍTULO EJE Y -->

        <text
          class="tri18-axis-title"

          x="21"
          y="140"

          text-anchor="middle"

          transform="
            rotate(
              -90
              21
              140
            )
          "
        >
          CANTIDAD
        </text>


        <!-- BARRAS -->

        <% chartBars.forEach(function(item, index) { %>


          <rect

            x="<%= item.x %>"
            y="<%= item.y %>"

            width="<%= item.width %>"
            height="<%= item.height %>"

            fill="url(#tri18Bars)"
          ></rect>


          <text
            class="tri18-bar-value"

            x="<%= item.centerX %>"
            y="<%= item.y - 8 %>"

            text-anchor="middle"
          >
            <%= tri18Quantity(item.quantity) %>
          </text>


          <!-- NOMBRE -->

          <foreignObject

            x="<%=
              chart.left +
              slotWidth * index +
              2
            %>"

            y="255"

            width="<%=
              Math.max(
                20,
                slotWidth - 4
              )
            %>"

            height="77"
          >

            <div
              xmlns="http://www.w3.org/1999/xhtml"
              class="tri18-chart-label"
              title="<%= item.name %>"
            >
              <%= tri18Short(item.name, 36) %>
            </div>

          </foreignObject>


        <% }); %>


      </svg>


    </article>



    <!-- ===================================================
         TABLA
         =================================================== -->

    <article class="tri18-card">


      <div class="tri18-card-header">

        <div class="tri18-card-header-icon">

          <svg viewBox="0 0 48 48">

            <rect
              x="9"
              y="6"
              width="30"
              height="36"
              rx="2"
              fill="none"
              stroke="#ffffff"
              stroke-width="3"
            ></rect>

            <path
              d="
                M15 14h18
                M15 21h18
                M15 28h18
                M15 35h18
              "
              fill="none"
              stroke="#ffffff"
              stroke-width="2.5"
              stroke-linecap="round"
            ></path>

          </svg>

        </div>


        <div class="tri18-card-title">
          Detalle Top 10 insumos
        </div>

      </div>


      <div class="tri18-table-wrap">


        <table class="tri18-table">


          <thead>

            <tr>

              <th class="tri18-col-rank">
                N°
              </th>

              <th class="tri18-col-supply">
                Insumo
              </th>

              <th class="tri18-col-quantity">
                Cantidad
              </th>

              <th class="tri18-col-unit">
                Unidad
              </th>

              <th class="tri18-col-share">
                % del total
              </th>

            </tr>

          </thead>


          <tbody>


            <% tableRows.forEach(function(item, index) { %>


              <tr>


                <% if (item) { %>


                  <td class="tri18-table-rank">
                    <%= index + 1 %>
                  </td>


                  <td
                    class="tri18-table-supply"
                    title="<%= item.name %>"
                  >
                    <%= item.name %>
                  </td>


                  <td
                    class="
                      tri18-table-quantity
                      <%= index === 0 ? 'principal' : '' %>
                    "
                  >
                    <%= tri18Quantity(item.quantity) %>
                  </td>


                  <td class="tri18-table-unit">
                    <%= item.unit || 's/u' %>
                  </td>


                  <td
                    class="
                      tri18-table-share
                      <%= index === 0 ? 'principal' : '' %>
                    "
                  >
                    <%= tri18Pct(item.share) %>
                  </td>


                <% } else { %>


                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>
                  <td></td>


                <% } %>


              </tr>


            <% }); %>


          </tbody>


        </table>


      </div>


    </article>


  </section>



  <!-- =====================================================
       LECTURA INFERIOR
       ===================================================== -->

  <section class="tri18-insight">


    <div class="tri18-insight-icon">

      <svg viewBox="0 0 64 64">

        <rect
          x="10"
          y="40"
          width="8"
          height="12"
          rx="1.5"
          fill="#ffffff"
        ></rect>

        <rect
          x="24"
          y="32"
          width="8"
          height="20"
          rx="1.5"
          fill="#ffffff"
        ></rect>

        <rect
          x="38"
          y="22"
          width="8"
          height="30"
          rx="1.5"
          fill="#ffffff"
        ></rect>


        <path
          d="
            M9 31
            L22 24
            L31 28
            L49 10
          "
          fill="none"
          stroke="#ffffff"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>


        <path
          d="
            M40 10
            H50
            V20
          "
          fill="none"
          stroke="#ffffff"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>

      </svg>

    </div>


    <div class="tri18-insight-divider"></div>


    <div class="tri18-insight-copy">

      <div class="tri18-insight-title">
        Consumo de insumos
      </div>


      <div class="tri18-insight-text">

        El insumo de mayor consumo es
        "<strong><%= principal.name %></strong>",
        con
        <strong>
          <%= tri18Quantity(principal.quantity) %>
          <%= principal.unit %>
        </strong>
        y
        <strong><%= tri18Pct(principalShare) %></strong>
        del total.
        <br>

        El Top 3 representa
        <strong><%= tri18Pct(top3CumulativeShare) %></strong>
        de la cantidad acumulada y el Top 10 concentra
        <strong><%= tri18Pct(top10Share) %></strong>.

      </div>

    </div>


    <div class="tri18-insight-decoration">

      <span></span>
      <span></span>
      <span></span>

    </div>


  </section>


</div>
