<%

/* =========================================================
   DATA
   ========================================================= */

const q =
  typeof quarterly !== 'undefined' &&
  quarterly
    ? quarterly
    : {};


const totalsInput =
  typeof monthlySeries !== 'undefined' &&
  Array.isArray(monthlySeries)
    ? monthlySeries.slice(0, 3)
    : [];


/* =========================================================
   HELPERS
   ========================================================= */

function tri16Number(value) {

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : 0;

}


function tri16Format(value) {

  if (
    typeof formatNumber ===
    'function'
  ) {

    return formatNumber(value);

  }

  return tri16Number(value);

}


function tri16Pct(value) {

  return tri16Number(value)
    .toFixed(1);

}


function tri16Change(
  current,
  previous
) {

  const currentValue =
    tri16Number(current);

  const previousValue =
    tri16Number(previous);


  if (
    previousValue === 0
  ) {

    return null;

  }


  return (
    (
      currentValue -
      previousValue
    ) /
    previousValue
  ) * 100;

}


function tri16SignedPct(value) {

  if (
    value === null ||
    !Number.isFinite(value)
  ) {

    return '—';

  }


  const sign =
    value > 0
      ? '+'
      : '';


  return (
    sign +
    value.toFixed(1) +
    '%'
  );

}


function tri16SignedPoints(value) {

  if (
    value === null ||
    !Number.isFinite(value)
  ) {

    return '—';

  }


  const sign =
    value > 0
      ? '+'
      : '−';


  return (
    sign +
    Math.abs(value).toFixed(1) +
    ' p.p.'
  );

}


/* =========================================================
   MESES TOTALES
   ========================================================= */

const totals =
  Array.from(
    {
      length: 3
    },
    (
      _,
      index
    ) => {

      const fallback = [
        {
          month: 'Mayo',
          value: 46
        },
        {
          month: 'Junio',
          value: 57
        },
        {
          month: 'Julio',
          value: 80
        }
      ][index];


      return (
        totalsInput[index] ||
        fallback
      );

    }
  );


/* =========================================================
   CASOS USB-C POR MES
   =========================================================

   Apps Script podrá enviar:

   quarterly: {

     usbCMonthly: [

       {
         month: "Mayo",
         value: 14
       },

       {
         month: "Junio",
         value: 19
       },

       {
         month: "Julio",
         value: 16
       }

     ]

   }

   También aceptamos nombres alternativos.
*/

const usbInput =
  Array.isArray(q.usbCMonthly)
    ? q.usbCMonthly

    : Array.isArray(q.usbMonthly)
      ? q.usbMonthly

      : Array.isArray(q.cambioUsbCMonthly)
        ? q.cambioUsbCMonthly

        : [];


/*
   Fallback para el diseño de prueba.
*/

const usbFallback = [

  {
    month: 'Mayo',
    value: 14
  },

  {
    month: 'Junio',
    value: 19
  },

  {
    month: 'Julio',
    value: 16
  }

];


const usbMonths =
  Array.from(
    {
      length: 3
    },
    (
      _,
      index
    ) => {

      const item =
        usbInput[index] ||
        usbFallback[index];


      return {

        month:
          String(
            item.month ??
            item.mes ??
            totals[index].month ??
            ''
          ),

        value:
          tri16Number(
            item.value ??
            item.count ??
            item.cantidad ??
            item.casos
          )

      };

    }
  );


/* =========================================================
   VALORES
   ========================================================= */

const usb1 =
  usbMonths[0].value;


const usb2 =
  usbMonths[1].value;


const usb3 =
  usbMonths[2].value;


const total1 =
  tri16Number(
    totals[0].value
  );


const total2 =
  tri16Number(
    totals[1].value
  );


const total3 =
  tri16Number(
    totals[2].value
  );


/* =========================================================
   PARTICIPACIÓN USB-C
   ========================================================= */

const share1 =
  total1 > 0
    ? (
        usb1 /
        total1
      ) * 100
    : 0;


const share2 =
  total2 > 0
    ? (
        usb2 /
        total2
      ) * 100
    : 0;


const share3 =
  total3 > 0
    ? (
        usb3 /
        total3
      ) * 100
    : 0;


/* =========================================================
   KPI INFERIORES
   ========================================================= */

const usbThirdVsSecond =
  tri16Change(
    usb3,
    usb2
  );


const participationChange =
  share3 -
  share2;


const totalThirdVsSecond =
  tri16Change(
    total3,
    total2
  );


/* =========================================================
   ESCALA GRÁFICO DE BARRAS
   ========================================================= */

function tri16NiceAxis(
  maximum,
  divisions = 4
) {

  const maxValue =
    Math.max(
      1,
      tri16Number(maximum)
    );


  const rawStep =
    maxValue /
    divisions;


  const magnitude =
    Math.pow(
      10,
      Math.floor(
        Math.log10(
          rawStep
        )
      )
    );


  const normalized =
    rawStep /
    magnitude;


  const choices = [
    1,
    2,
    2.5,
    5,
    10
  ];


  let nice =
    choices[
      choices.length - 1
    ];


  for (
    const candidate
    of choices
  ) {

    if (
      candidate >=
      normalized
    ) {

      nice =
        candidate;

      break;

    }

  }


  const step =
    nice *
    magnitude;


  const axisMaximum =
    Math.ceil(
      maxValue /
      step
    ) *
    step;


  return {

    step,

    maximum:
      axisMaximum

  };

}


const barMaximumValue =
  Math.max(
    usb1,
    usb2,
    usb3
  );


const barAxis =
  tri16NiceAxis(
    barMaximumValue,
    4
  );


const barTicks = [];


for (
  let value = 0;
  value <= barAxis.maximum + 0.001;
  value += barAxis.step
) {

  barTicks.push(
    value
  );

}


/* =========================================================
   POSICIONES GRÁFICO BARRAS
   ========================================================= */

const barPlot = {

  left: 58,

  right: 700,

  top: 24,

  bottom: 290

};


const barPlotHeight =
  barPlot.bottom -
  barPlot.top;


const barData = [

  {
    x: 96,
    width: 138,
    month: usbMonths[0].month,
    value: usb1
  },

  {
    x: 310,
    width: 138,
    month: usbMonths[1].month,
    value: usb2
  },

  {
    x: 524,
    width: 138,
    month: usbMonths[2].month,
    value: usb3
  }

];


barData.forEach(
  item => {

    item.height =
      barAxis.maximum > 0
        ? (
            item.value /
            barAxis.maximum
          ) *
          barPlotHeight
        : 0;


    item.y =
      barPlot.bottom -
      item.height;

  }
);


/* =========================================================
   ESCALA GRÁFICO PARTICIPACIÓN
   ========================================================= */

const maximumShare =
  Math.max(
    share1,
    share2,
    share3
  );


/*
   Mínimo 40% para que el ejemplo
   se vea exactamente como la referencia.

   Si en otro trimestre supera 40%,
   el eje aumenta automáticamente.
*/

const shareAxisMaximum =
  Math.max(
    40,
    Math.ceil(
      maximumShare /
      10
    ) * 10
  );


const shareTicks = [];


for (
  let value = 0;
  value <= shareAxisMaximum;
  value += 10
) {

  shareTicks.push(
    value
  );

}


/* =========================================================
   PUNTOS LÍNEA
   ========================================================= */

const linePlot = {

  left: 72,

  right: 696,

  top: 24,

  bottom: 290

};


const linePlotHeight =
  linePlot.bottom -
  linePlot.top;


const linePoints = [

  {
    x: 168,
    month: usbMonths[0].month,
    value: share1
  },

  {
    x: 382,
    month: usbMonths[1].month,
    value: share2
  },

  {
    x: 596,
    month: usbMonths[2].month,
    value: share3
  }

];


linePoints.forEach(
  item => {

    item.y =
      linePlot.bottom -
      (
        item.value /
        shareAxisMaximum
      ) *
      linePlotHeight;

  }
);


const linePath =
  linePoints
    .map(
      (
        point,
        index
      ) =>

        `${
          index === 0
            ? 'M'
            : 'L'
        } ${point.x} ${point.y}`

    )
    .join(' ');

%>


