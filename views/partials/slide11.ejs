/* =========================================================
   DATA DINÁMICA
   ========================================================= */

const m =
  typeof metrics !== 'undefined' &&
  metrics
    ? metrics
    : {};


const allCategories =
  typeof categories !== 'undefined' &&
  Array.isArray(categories)
    ? categories
    : [];


/*
   Mostramos máximo 8 categorías,
   como en el diseño de referencia.
*/

const chartCategories =
  allCategories
    .slice(0, 8);


/*
   Total de atenciones.
*/

const total =
  Number(
    m.totalAttentions ??
    chartCategories.reduce(
      (acc, item) =>
        acc + Number(item.count || 0),
      0
    )
  ) || 0;


/* =========================================================
   HELPERS LOCALES
   ========================================================= */

function tri11Number(value) {

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : 0;

}


function tri11Pct(value) {

  return tri11Number(value)
    .toFixed(1);

}


/*
   Calcula una escala agradable para el eje.

   Ejemplo:
   máximo 69
   → eje máximo 80

   máximo 112
   → eje máximo 140 aproximadamente,
   dependiendo de la escala.
*/

function tri11NiceStep(value) {

  if (
    !Number.isFinite(value) ||
    value <= 0
  ) {
    return 10;
  }


  const exponent =
    Math.floor(
      Math.log10(value)
    );


  const magnitude =
    Math.pow(
      10,
      exponent
    );


  const normalized =
    value /
    magnitude;


  let niceNormalized;


  if (normalized <= 1) {

    niceNormalized = 1;

  } else if (normalized <= 2) {

    niceNormalized = 2;

  } else if (normalized <= 5) {

    niceNormalized = 5;

  } else {

    niceNormalized = 10;

  }


  return (
    niceNormalized *
    magnitude
  );

}


/*
   Máximo real de categorías.
*/

const realMaximum =
  Math.max(
    0,
    ...chartCategories.map(
      item =>
        tri11Number(
          item.count
        )
    )
  );


/*
   Agregamos margen visual para que
   la barra más grande no llegue
   completamente al borde derecho.
*/

const paddedMaximum =
  realMaximum *
  1.12;


/*
   Queremos aproximadamente
   entre 7 y 9 divisiones.
*/

const rawStep =
  paddedMaximum > 0
    ? paddedMaximum / 8
    : 10;


const axisStep =
  tri11NiceStep(
    rawStep
  );


let axisMaximum =
  Math.ceil(
    paddedMaximum /
    axisStep
  ) *
  axisStep;


/*
   Seguridad cuando no hay datos.
*/

if (
  !axisMaximum ||
  axisMaximum <= 0
) {

  axisMaximum = 80;

}


/*
   Ejemplo 69:
   step = 10
   axisMaximum = 80
*/

const axisTicks = [];


for (
  let value = 0;
  value <= axisMaximum + 0.0001;
  value += axisStep
) {

  axisTicks.push(
    Number(
      value.toFixed(6)
    )
  );

}


/* =========================================================
   COMPLETAR A 8 FILAS
   =========================================================

   Si un trimestre tiene menos categorías,
   conservamos la geometría del diseño,
   pero las filas sobrantes quedan vacías.
*/

const rows =
  Array.from(
    {
      length: 8
    },
    (
      _,
      index
    ) =>
      chartCategories[index] || null
  );


/* =========================================================
   TOP 1 / TOP 2
   ========================================================= */

const primary =
  chartCategories[0] || {
    name: 'Sin datos',
    count: 0
  };


const secondary =
  chartCategories[1] || {
    name: 'Sin datos',
    count: 0
  };


const primaryShare =
  total > 0
    ? (
        tri11Number(
          primary.count
        ) /
        total
      ) * 100
    : 0;


const secondaryShare =
  total > 0
    ? (
        tri11Number(
          secondary.count
        ) /
        total
      ) * 100
    : 0;


const top2Count =
  tri11Number(
    primary.count
  ) +
  tri11Number(
    secondary.count
  );


const top2Share =
  total > 0
    ? (
        top2Count /
        total
      ) * 100
    : 0;


/* =========================================================
   TEXTO SEGURO
   ========================================================= */

function tri11Name(value) {

  return String(
    value ?? ''
  ).trim();

}

%>


