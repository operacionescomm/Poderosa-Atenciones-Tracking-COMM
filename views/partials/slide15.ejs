          <% if (threePct >= 5) { %>

            <text
              class="tri15-donut-pct"
              x="<%= threeLabel.x %>"
              y="<%= threeLabel.y %>"
            >

              <%= Math.round(threePct) %>%

            </text>

          <% } %>


        </svg>


      </div>



      <!-- =================================================
           LEYENDA
           ================================================= -->

      <div class="tri15-legend">


        <div class="tri15-legend-item">

          <span
            class="
              tri15-legend-box
              blue
            "
          ></span>

          <span>
            1 atención
          </span>

        </div>


        <div class="tri15-legend-item">

          <span
            class="
              tri15-legend-box
              teal
            "
          ></span>

          <span>
            2 atenciones
          </span>

        </div>


        <div class="tri15-legend-item">

          <span
            class="
              tri15-legend-box
              orange
            "
          ></span>

          <span>
            3 o más
          </span>

        </div>


      </div>


    </section>



    <!-- ===================================================
         COLUMNA DERECHA
         =================================================== -->

    <aside class="tri15-side">


      <!-- =================================================
           UNA ATENCIÓN
           ================================================= -->

      <article class="tri15-kpi blue">


        <div class="tri15-kpi-icon">

          <svg
            viewBox="0 0 48 48"
