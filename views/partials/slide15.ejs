}


.tri15-kpi-decoration svg {
  width: 100%;
  height: 100%;

  display: block;
}


/* =========================================================
   COLORES
   ========================================================= */

.tri15-kpi.blue {
  --accent: #1764e8;
}


.tri15-kpi.teal {
  --accent: #16b4c1;

  background:
    linear-gradient(
      110deg,
      #ffffff 0%,
      #f4fcfd 100%
