}


.tri15-kpi-icon svg {
  width: 49px;
  height: 49px;

  display: block;
}


/* =========================================================
   TEXTO KPI
   ========================================================= */

.tri15-kpi-copy {
  min-width: 0;
}


.tri15-kpi-label {
  color: #47628c;

  font-size: 16px;

  line-height: 1;

  font-weight: 800;

  text-transform: uppercase;
}


.tri15-kpi-number {
  margin-top: 15px;

  color:
    var(--accent);

  font-size: 44px;

  line-height: 0.9;

  font-weight: 800;

  letter-spacing: -0.8px;

