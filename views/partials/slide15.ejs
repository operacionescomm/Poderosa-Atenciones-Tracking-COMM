  display: flex;

  align-items: center;

  justify-content: center;

  gap: 55px;
}


.tri15-legend-item {
  display: flex;

  align-items: center;

  gap: 10px;

  color: #173c82;

  font-size: 18px;

  line-height: 1;

  font-weight: 600;

  white-space: nowrap;
}


.tri15-legend-box {
  width: 23px;
  height: 23px;

  border-radius: 5px;

  display: flex;

  align-items: center;

  justify-content: center;

  color: #ffffff;

  box-shadow:
    0 2px 5px
    rgba(20, 65, 120, 0.10);
}


.tri15-legend-box::after {
  content: "";

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #ffffff;
}


.tri15-legend-box.blue {
  background: #1764d9;
}


.tri15-legend-box.teal {
  background: #10aebe;
}


.tri15-legend-box.orange {
  background: #ff8a0b;
}


/* =========================================================
   COLUMNA DERECHA
   ========================================================= */

.tri15-side {
  height: 646px;

  display: grid;

  grid-template-rows:
    164px
    164px
    164px
    100px;

  row-gap: 18px;
}


/* =========================================================
   KPI CARDS
   ========================================================= */

.tri15-kpi {
  position: relative;

  height: 164px;

  display: grid;

  grid-template-columns:
    94px
    minmax(0, 1fr)
    100px;

  column-gap: 18px;

  align-items: center;

  padding:
    18px
    15px
    18px
    35px;

  overflow: hidden;

  border:
    1.5px solid
    #d5e6f5;

  border-radius: 17px;

