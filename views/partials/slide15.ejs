}


/* =========================================================
   BANNER INFERIOR
   ========================================================= */

.tri15-summary {
  position: relative;

  height: 100px;

  display: grid;

  grid-template-columns:
    80px
    2px
    minmax(0, 1fr);

  column-gap: 20px;

  align-items: center;

  padding:
    12px
    24px
    12px
    20px;

