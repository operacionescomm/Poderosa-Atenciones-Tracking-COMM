</style>


<%

/* =========================================================
   DATA
   ========================================================= */

const m =
  typeof metrics !== 'undefined' &&
  metrics
    ? metrics
    : {};


const q =
  typeof quarterly !== 'undefined' &&
  quarterly
    ? quarterly
    : {};


/* =========================================================
   HELPERS
   ========================================================= */

function tri15Number(value) {

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : 0;

}


function tri15Format(value) {

  if (
    typeof formatNumber ===
    'function'
  ) {

    return formatNumber(value);

  }

  return tri15Number(value);

}


function tri15Pct(value) {

  return tri15Number(value)
    .toFixed(1);

}


/* =========================================================
   TOTAL DE DISPOSITIVOS
   ========================================================= */

const totalDevices =
  tri15Number(
    m.uniqueDevices ??
    m.uniqueVehicles ??
    q.totalDevices ??
    128
  );


/* =========================================================
   DISTRIBUCIÓN
   ========================================================= */

const distribution =
  q.recurrenceDistribution ||
  q.reincidenceDistribution ||
  q.distribucionReincidencia ||
  {};


const threePlus =
  tri15Number(
    distribution.threeOrMore ??
    distribution.threePlus ??
    distribution.tresOMas ??
    m.reincidenceCount ??
    10
  );


let twoAttentions =
  distribution.twoAttentions ??
  distribution.two ??
  distribution.dosAtenciones;


if (
  twoAttentions === undefined ||
  twoAttentions === null ||
  twoAttentions === ''
) {

  twoAttentions = 32;

}


twoAttentions =
  tri15Number(
    twoAttentions
  );


let oneAttention =
  distribution.oneAttention ??
  distribution.one ??
  distribution.unaAtencion;


if (
  oneAttention === undefined ||
  oneAttention === null ||
  oneAttention === ''
) {

  oneAttention =
    Math.max(
      0,
      totalDevices -
      twoAttentions -
      threePlus
    );

}


oneAttention =
  tri15Number(
    oneAttention
  );


const distributionTotal =
  oneAttention +
  twoAttentions +
  threePlus;


const percentageBase =
  totalDevices > 0
    ? totalDevices
    : distributionTotal;


/* =========================================================
   PORCENTAJES
   ========================================================= */

const onePct =
  percentageBase > 0
    ? (
        oneAttention /
        percentageBase
      ) * 100
    : 0;


const twoPct =
  percentageBase > 0
    ? (
        twoAttentions /
        percentageBase
      ) * 100
    : 0;


const threePct =
  percentageBase > 0
    ? (
        threePlus /
        percentageBase
      ) * 100
    : 0;


const twoOrMore =
  twoAttentions +
  threePlus;


const twoOrMorePct =
  percentageBase > 0
    ? (
        twoOrMore /
        percentageBase
      ) * 100
    : 0;


/* =========================================================
   DONUT
   ========================================================= */

const radius = 170;


const circumference =
  2 *
  Math.PI *
  radius;


const oneLength =
  circumference *
  onePct /
  100;


const twoLength =
  circumference *
  twoPct /
  100;


const threeLength =
  circumference *
  threePct /
  100;


const oneOffset = 0;


const twoOffset =
  -oneLength;


const threeOffset =
  -(
    oneLength +
    twoLength
  );


function tri15LabelPosition(
  startPct,
  sharePct
) {

  const middlePct =
    startPct +
    sharePct / 2;


  const angle =
    (
      -90 +
      middlePct *
      3.6
    ) *
    Math.PI /
    180;


  const labelRadius =
    170;


  return {

    x:
      250 +
      Math.cos(angle) *
      labelRadius,

    y:
      250 +
      Math.sin(angle) *
      labelRadius

  };

}


const oneLabel =
  tri15LabelPosition(
    0,
    onePct
  );


const twoLabel =
  tri15LabelPosition(
    onePct,
    twoPct
  );


const threeLabel =
  tri15LabelPosition(
    onePct + twoPct,
    threePct
  );

%>


<div class="tri15">


  <div class="tri15-layout">


    <!-- ===================================================
         PANEL IZQUIERDO
         =================================================== -->

    <section class="tri15-main-card">


      <div class="tri15-panel-heading">


        <!-- =================================================
             ICONO PIE MEJORADO
             ================================================= -->

        <div class="tri15-panel-icon">

