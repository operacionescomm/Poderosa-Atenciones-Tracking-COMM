<style>

/* =========================================================
   SLIDE 15 · REINCIDENCIA DE DISPOSITIVOS
   Header y footer compartidos desde report.ejs
   ========================================================= */


/* =========================================================
   ÁREA GENERAL
   ========================================================= */

body.slide15-body .q-content {
  padding:
    24px
    34px
    8px
    34px !important;
}


.tri15 {
  width: 100%;
  height: 100%;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  color: #123b8f;
}


.tri15 *,
.tri15 *::before,
.tri15 *::after {
  box-sizing: border-box;
}


/* =========================================================
   LAYOUT PRINCIPAL
   ========================================================= */

.tri15-layout {
  width: 100%;
  height: 646px;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    640px;

  column-gap: 20px;
}


/* =========================================================
   PANEL IZQUIERDO
   ========================================================= */

.tri15-main-card {
  height: 646px;

  padding:
    24px
    28px
    18px
    28px;

  border:
    1.5px solid
    #d3e5f5;

  border-radius: 17px;

  background: #ffffff;

  box-shadow:
    0 5px 18px
    rgba(40, 84, 132, 0.07);

  overflow: hidden;
}


/* =========================================================
   TÍTULO DEL PANEL
   ========================================================= */

.tri15-panel-heading {
  height: 64px;

  display: flex;

  align-items: center;

  gap: 18px;
}


.tri15-panel-icon {
  width: 58px;
  height: 58px;

  flex: 0 0 58px;

  border-radius: 11px;

  display: flex;

  align-items: center;

  justify-content: center;

  background:
    linear-gradient(
      145deg,
      #e8f3ff 0%,
      #dcecff 100%
    );

  color: #1764ed;
}


.tri15-panel-icon svg {
  width: 40px;
  height: 40px;

  display: block;
}


.tri15-panel-title {
  margin: 0;

  color: #08256e;

  font-size: 28px;

  line-height: 1;

  font-weight: 800;

  letter-spacing: -0.5px;
}


/* =========================================================
   DONUT
   ========================================================= */

.tri15-donut-area {
  height: 472px;

  display: flex;

  align-items: center;

  justify-content: center;

  position: relative;
}


.tri15-donut-svg {
  width: 470px;
  height: 470px;

  display: block;

  overflow: visible;
}


.tri15-donut-track {
  fill: none;

  stroke: #e8eef6;

  stroke-width: 94;
}


.tri15-donut-segment {
  fill: none;

  stroke-width: 94;

  stroke-linecap: butt;

  transform:
    rotate(-90deg);

  transform-origin:
    250px
    250px;
}


.tri15-donut-segment.one {
  stroke: #1764d9;
}


.tri15-donut-segment.two {
  stroke: #10aebe;
}


.tri15-donut-segment.three {
  stroke: #ff8a0b;
}


/* =========================================================
   CENTRO DEL DONUT
   ========================================================= */

.tri15-center-value {
  fill: #082e72;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 55px;

  font-weight: 800;
}


.tri15-center-label {
  fill: #52709f;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 19px;

  font-weight: 700;

  text-transform: uppercase;
}


/* =========================================================
   PORCENTAJES SOBRE EL DONUT
   ========================================================= */

.tri15-donut-pct {
  fill: #ffffff;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

  font-size: 23px;

  font-weight: 800;

  text-anchor: middle;

  dominant-baseline: middle;
}


/* =========================================================
   LEYENDA
   ========================================================= */

.tri15-legend {
