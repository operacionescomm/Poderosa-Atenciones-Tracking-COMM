.tri15-kpi-description {
  margin-top: 15px;

  color: #254a83;

  font-size: 15px;

  line-height: 1.15;

  font-weight: 500;

  white-space: nowrap;
}


/* =========================================================
   DECORACIÓN KPI
   ========================================================= */

.tri15-kpi-decoration {
  width: 100px;
  height: 100px;

  display: flex;

  align-items: center;

  justify-content: center;

  color:
