/* =========================================================
   DATA
   ========================================================= */

const series =
  typeof monthlySeries !== 'undefined' &&
  Array.isArray(monthlySeries)
    ? monthlySeries.slice(0, 3)
    : [];


/*
   Siempre esperamos tres meses.
   Si temporalmente faltara alguno,
   completamos el espacio.
*/

const months =
  Array.from(
    {
      length: 3
    },
    (
      _,
      index
    ) =>
      series[index] || {
        month: `Mes ${index + 1}`,
        value: 0
      }
  );


/* =========================================================
   HELPERS
   ========================================================= */

function tri12Number(value) {

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : 0;

}


function tri12Format(value) {

  if (
    typeof formatNumber ===
    'function'
  ) {

    return formatNumber(value);

  }

  return tri12Number(value);

}


function tri12Pct(
  current,
  previous
) {

  const currentValue =
    tri12Number(current);

  const previousValue =
    tri12Number(previous);


  if (
    previousValue === 0
  ) {

    return null;

  }


  return (
    (
      currentValue -
      previousValue
    ) /
    previousValue
  ) * 100;

}


function tri12PctText(value) {

  if (
    value === null ||
    !Number.isFinite(value)
  ) {

    return '—';

  }


  const sign =
    value > 0
      ? '+'
      : '';


  return (
    sign +
    value.toFixed(1) +
    '%'
  );

}


/*
   Escala bonita con aproximadamente
   cuatro intervalos.

   80 -> 0,20,40,60,80
*/

function tri12Axis(value) {

  const maxValue =
    Math.max(
      1,
      tri12Number(value)
    );


  const roughStep =
    maxValue /
    4;


  const magnitude =
    Math.pow(
      10,
      Math.floor(
        Math.log10(
          roughStep
        )
      )
    );


  const normalized =
    roughStep /
    magnitude;


  const choices =
    [
      1,
      2,
      2.5,
      3,
      4,
      5,
      10
    ];


  let selected =
    choices[
      choices.length - 1
    ];


  for (
    const candidate
    of choices
  ) {

    if (
      candidate >=
      normalized
    ) {

      selected =
        candidate;

      break;

    }

  }


  const step =
    selected *
    magnitude;


  const maximum =
    Math.ceil(
      maxValue /
      step
    ) *
    step;


  return {
    step,
    maximum
  };

}


/* =========================================================
   VALORES MENSUALES
   ========================================================= */

const first =
  months[0];


const second =
  months[1];


const third =
  months[2];


const firstValue =
  tri12Number(
    first.value
  );


const secondValue =
  tri12Number(
    second.value
  );


const thirdValue =
  tri12Number(
    third.value
  );


const maximumValue =
  Math.max(
    firstValue,
    secondValue,
    thirdValue
  );


const axis =
  tri12Axis(
    maximumValue
  );


const axisMaximum =
  axis.maximum;


const axisStep =
  axis.step;


const ticks = [];


for (
  let tick = 0;
  tick <= axisMaximum + 0.0001;
  tick += axisStep
) {

  ticks.push(
    Number(
      tick.toFixed(6)
    )
  );

}


/* =========================================================
   COMPARACIONES
   ========================================================= */

const changeSecondVsFirst =
  tri12Pct(
    secondValue,
    firstValue
  );


const changeThirdVsSecond =
  tri12Pct(
    thirdValue,
    secondValue
  );


const accumulatedGrowth =
  tri12Pct(
    thirdValue,
    firstValue
  );


const accumulatedDifference =
  thirdValue -
  firstValue;


/* =========================================================
   MENSAJE DE DIFERENCIA
   ========================================================= */

let accumulatedDescription;


if (
  accumulatedDifference > 0
) {

  accumulatedDescription =
    `${third.month} registró ` +
    `${tri12Format(accumulatedDifference)} atenciones más que ${first.month}.`;

} else if (
  accumulatedDifference < 0
) {

  accumulatedDescription =
    `${third.month} registró ` +
    `${tri12Format(Math.abs(accumulatedDifference))} atenciones menos que ${first.month}.`;

} else {

  accumulatedDescription =
    `${third.month} registró la misma cantidad de atenciones que ${first.month}.`;

}


/* =========================================================
   MENSAJE OPERATIVO INFERIOR
   ========================================================= */

const maxMonth =
  months.reduce(
    (
      best,
      item
    ) =>
      tri12Number(item.value) >
      tri12Number(best.value)
        ? item
        : best,
    months[0]
  );


const lastMonthIsMaximum =
  maxMonth === third;


const operationalMessage =
  lastMonthIsMaximum
    ? 'Mayor carga operativa al cierre del trimestre'
    : `Mayor carga operativa registrada en ${maxMonth.month}`;

%>


