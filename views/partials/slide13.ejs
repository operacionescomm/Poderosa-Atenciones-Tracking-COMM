<%

/* =========================================================
   DATA DINÁMICA
   ========================================================= */

const m =
  typeof metrics !== 'undefined' &&
  metrics
    ? metrics
    : {};


const companyData =
  typeof companies !== 'undefined' &&
  Array.isArray(companies)
    ? companies.slice(0, 10)
    : [];


/*
   Total general del trimestre.
*/

const totalAttentions =
  Number(
    m.totalAttentions ?? 0
  ) || 0;


/*
   Total de compañías atendidas.
   Este valor puede ser mayor a 10,
   ya que el gráfico solo muestra el ranking.
*/

const totalCompanies =
  Number(
    m.companiesCount ??
    (
      typeof allCompanies !== 'undefined' &&
      Array.isArray(allCompanies)
        ? allCompanies.length
        : companyData.length
    )
  ) || 0;


/* =========================================================
   HELPERS
   ========================================================= */

function tri13Number(value) {

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : 0;

}


function tri13Format(value) {

  if (
    typeof formatNumber ===
    'function'
  ) {

    return formatNumber(value);

  }

  return tri13Number(value);

}


function tri13Percent(value) {

  const n =
    tri13Number(value);

  return n.toFixed(1);

}


function tri13Name(value) {

  return String(
    value ?? ''
  ).trim();

}


/*
   Escala horizontal agradable.

   Ejemplo:

   máximo = 16
   step = 2
   eje máximo = 18

   como en la referencia.
*/

function tri13NiceStep(value) {

  if (
    !Number.isFinite(value) ||
    value <= 0
  ) {

    return 2;

  }


  const exponent =
    Math.floor(
      Math.log10(value)
    );


  const magnitude =
    Math.pow(
      10,
      exponent
    );


  const normalized =
    value /
    magnitude;


  let nice;


  if (
    normalized <= 1
  ) {

    nice = 1;

  } else if (
    normalized <= 2
  ) {

    nice = 2;

  } else if (
    normalized <= 5
  ) {

    nice = 5;

  } else {

    nice = 10;

  }


  return (
    nice *
    magnitude
  );

}


/* =========================================================
   ESCALA
   ========================================================= */

const maximumCompanyValue =
  Math.max(
    0,
    ...companyData.map(
      item =>
        tri13Number(
          item.count
        )
    )
  );


const rawStep =
  maximumCompanyValue > 0
    ? maximumCompanyValue / 8
    : 2;


const axisStep =
  tri13NiceStep(
    rawStep
  );


let axisMaximum =
  (
    Math.ceil(
      maximumCompanyValue /
      axisStep
    ) +
    1
  ) *
  axisStep;


if (
  !axisMaximum ||
  axisMaximum <= 0
) {

  axisMaximum = 18;

}


const axisTicks = [];


for (
  let tick = 0;
  tick <= axisMaximum + 0.0001;
  tick += axisStep
) {

  axisTicks.push(
    Number(
      tick.toFixed(6)
    )
  );

}


/* =========================================================
   COMPLETAR HASTA 10 FILAS
   ========================================================= */

const rows =
  Array.from(
    {
      length: 10
    },
    (
      _,
      index
    ) =>
      companyData[index] ||
      null
  );


/* =========================================================
   PRIMERA COMPAÑÍA
   ========================================================= */

const firstCompany =
  companyData[0] || {
    name:
      'Sin datos',

    count:
      0
  };


const firstCompanyShare =
  totalAttentions > 0

    ? (
        tri13Number(
          firstCompany.count
        ) /
        totalAttentions
      ) * 100

    : 0;


/* =========================================================
   TOP 3
   ========================================================= */

const top3Count =
  companyData
    .slice(
      0,
      3
    )
    .reduce(
      (
        total,
        item
      ) =>
        total +
        tri13Number(
          item.count
        ),

      0
    );


const top3Share =
  totalAttentions > 0

    ? (
        top3Count /
        totalAttentions
      ) * 100

    : 0;


/* =========================================================
   TOP 10
   ========================================================= */

const top10Count =
  companyData
    .slice(
      0,
      10
    )
    .reduce(
      (
        total,
        item
      ) =>
        total +
        tri13Number(
          item.count
        ),

      0
    );


const top10Share =
  totalAttentions > 0

    ? (
        top10Count /
        totalAttentions
      ) * 100

    : 0;

%>


