            viewBox="0 0 24 24"
            aria-hidden="true"
          >

            <rect
              x="4"
              y="13"
              width="3.5"
              height="7"
              rx="1"
              fill="currentColor"
            ></rect>

            <rect
              x="10.25"
              y="9"
              width="3.5"
              height="11"
              rx="1"
              fill="currentColor"
            ></rect>

            <rect
              x="16.5"
              y="4"
              width="3.5"
              height="16"
              rx="1"
              fill="currentColor"
            ></rect>

          </svg>

        </div>

        <span>
          EVOLUCIÓN
          <%= evolutionStartMonth.toUpperCase() %>
          →
          <%= evolutionEndMonth.toUpperCase() %>
        </span>

      </div>


      <div class="tri10-analysis-body">

        <div>

          <div class="tri10-analysis-value">

            <%= signedPercent(evolutionPct) %>

          </div>

          <div class="tri10-analysis-text">

            Las atenciones pasaron de
            <%= displayNumber(evolutionStart) %>
            a
            <%= displayNumber(evolutionEnd) %>.

          </div>

        </div>


        <!-- GRÁFICO DE EVOLUCIÓN DINÁMICO -->

        <div class="tri10-evolution-graphic">

          <svg
            viewBox="0 0 130 110"
            aria-hidden="true"
          >

            <defs>

              <linearGradient
                id="tri10EvolutionBars"
                x1="0"
                y1="0"
                x2="0"
                y2="1"
              >

                <stop
                  offset="0%"
                  stop-color="#3c9cff"
                ></stop>

                <stop
                  offset="100%"
                  stop-color="#8dcbff"
                ></stop>

              </linearGradient>

            </defs>


            <% if (evolutionDirection === 'down') { %>

              <!-- barras descendentes -->

              <rect
                x="18"
                y="29"
                width="16"
                height="67"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="43"
                y="46"
                width="16"
                height="50"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="68"
                y="60"
                width="16"
                height="36"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="93"
                y="72"
                width="16"
                height="24"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>


              <!-- curva descendente -->

              <path
                d="
                  M18 18
                  C38 31 50 40 63 48
                  C78 58 90 65 104 74
                "
                fill="none"
                stroke="#2786f3"
                stroke-width="4"
                stroke-linecap="round"
              ></path>


              <!-- flecha hacia abajo -->

              <path
                d="
                  M93 74
                  H106
                  V61
                "
                fill="none"
                stroke="#2786f3"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>

            <% } else if (evolutionDirection === 'flat') { %>

              <!-- barras estables -->

              <rect
                x="18"
                y="53"
                width="16"
                height="43"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="43"
                y="50"
                width="16"
                height="46"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="68"
                y="52"
                width="16"
                height="44"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="93"
                y="51"
                width="16"
                height="45"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>


              <!-- tendencia estable -->

              <path
                d="
                  M18 42
                  C40 40 60 43 82 41
                  C91 40 98 40 105 40
                "
                fill="none"
                stroke="#2786f3"
                stroke-width="4"
                stroke-linecap="round"
              ></path>


              <!-- flecha horizontal -->

              <path
                d="
                  M95 34
                  L106 40
                  L95 46
                "
                fill="none"
                stroke="#2786f3"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>

            <% } else { %>

              <!-- barras ascendentes -->

              <rect
                x="18"
                y="72"
                width="16"
                height="24"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="43"
                y="60"
                width="16"
                height="36"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="68"
                y="46"
                width="16"
                height="50"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>

              <rect
                x="93"
                y="29"
                width="16"
                height="67"
                rx="3"
                fill="url(#tri10EvolutionBars)"
              ></rect>


              <!-- curva ascendente -->

              <path
                d="
                  M18 62
                  C34 60 44 54 55 49
                  C68 43 82 33 103 18
                "
                fill="none"
                stroke="#2786f3"
                stroke-width="4"
                stroke-linecap="round"
              ></path>


              <!-- flecha hacia arriba -->

              <path
                d="
                  M92 18
                  H105
                  V31
                "
                fill="none"
                stroke="#2786f3"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>

            <% } %>

          </svg>

        </div>

      </div>

    </article>



