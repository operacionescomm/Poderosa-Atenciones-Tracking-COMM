/* =========================================================
   DATA
   ========================================================= */

const m =
  typeof metrics !== 'undefined' &&
  metrics
    ? metrics
    : {};

const c =
  typeof comparison !== 'undefined' &&
  comparison
    ? comparison
    : {};


/*
   Serie mensual real enviada por Apps Script.
   Se usa para que el bloque EVOLUCIÓN sea completamente dinámico.
*/
const monthlyData =
  typeof monthlySeries !== 'undefined' &&
  Array.isArray(monthlySeries)
    ? monthlySeries
    : [];


const totalAttentions =
  m.totalAttentions ??
  183;


const weeklyAverage =
  m.weeklyAverage ??
  m.averagePerWeek ??
  m.promedioSemanal ??
  13.9;


const companiesCount =
  m.companiesCount ??
  m.companyCount ??
  m.companiasAtendidas ??
  44;


const uniqueDevices =
  m.uniqueDevices ??
  m.devicesCount ??
  m.uniqueVehicles ??
  128;


const reincidenceCount =
  m.reincidenceCount ??
  m.reincidencia ??
  10;


const categoryShare =
  m.categoryConcentrationShare ??
  m.topCategoryShare ??
  64.5;


const categoryLabel =
  m.categoryConcentrationLabel ??
  m.topCategoryLabel ??
  'Mantenimiento básico y cambio de USB-C.';


const demandShare =
  m.demandShare ??
  m.topCompaniesShare ??
  53.6;


const topCompaniesCount =
  m.topCompaniesTopN ??
  10;


const topCompaniesAttentions =
  m.topCompaniesAttentions ??
  98;


const evolutionStart =
  c.previousTotal ??
  (
    monthlyData.length
      ? monthlyData[0].value
      : 46
  );


const evolutionEnd =
  c.currentTotal ??
  (
    monthlyData.length
      ? monthlyData[monthlyData.length - 1].value
      : 80
  );


const evolutionPct =
  c.variationPct ??
  m.variationPct ??
  (
    safeNumber(evolutionStart) !== 0
      ? (
          (
            safeNumber(evolutionEnd) -
            safeNumber(evolutionStart)
          ) /
          safeNumber(evolutionStart)
        ) * 100
      : 0
  );


const evolutionStartMonth =
  monthlyData.length
    ? String(monthlyData[0].month || '')
    : String(c.previousPeriod || 'Mayo');


const evolutionEndMonth =
  monthlyData.length
    ? String(
        monthlyData[
          monthlyData.length - 1
        ].month || ''
      )
    : 'Julio';


const evolutionDirection =
  safeNumber(evolutionPct) > 0
    ? 'up'
    : safeNumber(evolutionPct) < 0
      ? 'down'
      : 'flat';


const executiveTitle =
  m.executiveTitle ||
  'La demanda creció mes a mes y se concentró en mantenimiento preventivo y alimentación USB-C.';


const executiveBody =
  m.executiveBody ||
  'Julio fue el mes de mayor actividad (80). La participación de casos USB-C descendió a 20.0%, mientras que 10 vehículos requieren seguimiento focalizado por recurrencia.';


function safeNumber(value) {

  const n =
    Number(value);

  return Number.isFinite(n)
    ? n
    : 0;

}


function displayNumber(value) {

  if (
    typeof formatNumber ===
    'function'
  ) {

    return formatNumber(value);

  }

  return value;

}


function oneDecimal(value) {

  return safeNumber(value)
    .toFixed(1);

}


function signedPercent(value) {

  const n =
    safeNumber(value);

  const sign =
    n > 0
      ? '+'
      : n < 0
        ? '−'
        : '';

  return (
    sign +
    Math.abs(n).toFixed(1) +
    '%'
  );

}


function donutData(value) {

  const percentage =
    Math.max(
      0,
      Math.min(
        100,
        safeNumber(value)
      )
    );

  const r = 51;

  const circumference =
    2 * Math.PI * r;

  const dash =
    circumference *
    percentage /
    100;

  return {
    circumference,
    dash
  };

}


const categoryDonut =
  donutData(
    categoryShare
  );


const demandDonut =
  donutData(
    demandShare
  );

